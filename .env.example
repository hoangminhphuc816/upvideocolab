# =============================================================================
# .env.example — Pipeline MP4 → Kênh Telegram riêng tư
#
# Cách dùng:
#   cp .env.example .env   rồi điền giá trị thật; KHÔNG commit .env (đã trong .gitignore)
#
# Mọi biến này tương ứng 1:1 với Actions Secrets / Variables khi chạy trên GitHub
# (xem runbook.md §7). Các biến được chia nhóm theo nơi dùng:
#   - WORKER (chạy trên Colab VM): 8 biến pipeline — controller đọc trên runner rồi
#     truyền xuống VM qua bootstrap (prelude os.environ).
#   - CONTROLLER (chạy trên Actions runner / máy local): COLAB_TOKEN_JSON, WORKER_REPO.
#   - Optional: SHEET_NAME, DL_DIR (có default), WORKER_ID (auto).
#
# Tài liệu setup từng biến: runbook.md §1–7
# =============================================================================

# --- Worker pipeline (8 biến bắt buộc — worker.config._REQUIRED) ---

# StringSession Telethon (khóa đăng nhập tài khoản Telegram upload)
# Tạo: pip install telethon && python tools/make_session.py  (runbook §3)
# CẢNH BÁO: chuỗi này = full quyền tài khoản Telegram. KHÔNG commit, KHÔNG chia sẻ.
TELETHON_SESSION=

# Telegram API credentials — https://my.telegram.org → API development tools (runbook §2)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ID kênh Telegram riêng tư (dạng -100xxxxxxxxxx) — forward 1 tin từ kênh sang @userinfobot (runbook §1)
TARGET_CHANNEL=-100xxxxxxxxxx

# chat_id cá nhân của bạn (nhắn @userinfobot để lấy) — đích tin thông báo ✅/❌ (runbook §7)
OWNER_CHAT_ID=

# Service account JSON toàn bộ nội dung (1 dòng) — GCP project có Sheets API enabled,
# SA được Share Sheet Editor (runbook §5)
GCP_SA_JSON='{"type": "service_account", ...}'

# Google Sheet ID (trong URL giữa /d/ và /edit) — tab "Jobs" với header 11 cột (runbook §4)
SHEET_ID=

# Token bot Telegram hiện có (cùng bot đang nhận request X) (runbook §7)
BOT_TOKEN=1111111111:AAA...

# --- Controller (chạy trên Actions runner / máy local) ---

# Google OAuth refresh token của Colab CLI — pre-mint 1 lần (runbook §3b):
#   pip install google-colab-cli && colab whoami  (copy-paste URL auth)
#   → nội dung ~/.config/colab-cli/token.json → dán nguyên file JSON vào đây
# KHÔNG bao giờ xuống Colab VM; rotate = xoá + re-mint.
COLAB_TOKEN_JSON='{"refresh_token": "..."}'

# Repo GitHub public chứa pipeline này (owner/repo) — bootstrap trên VM git clone từ đây.
# Trên GitHub Actions đặt trong Settings → Secrets and variables → Actions → **Variables**
WORKER_REPO=your-username/your-worker-repo

# --- Optional (có default) ---

# Tên tab Sheet queue (default: Jobs)
SHEET_NAME=Jobs

# Thư mục download tạm trên worker (default: /tmp). Trên Colab VM KHÔNG đổi —
# /tmp ephemeral là ý đồ (part file không xuyên session → checkpoint semantics đúng).
DL_DIR=/tmp

# WORKER_ID: KHÔNG cần đặt tay — controller tự sinh (WORKER_ID fallback
# GITHUB_RUN_ID, VM nhận qua bootstrap); chỉ đặt khi chạy worker local ngoài pipeline.
# WORKER_ID=local-debug